@article{hadley_visualizing_2026,
	title = {Visualizing epidemiological models for policy: design principles for effective communication},
	volume = {14},
	copyright = {All rights reserved},
	issn = {2296-2565},
	shorttitle = {Visualizing epidemiological models for policy},
	url = {https://www.frontiersin.org/journals/public-health/articles/10.3389/fpubh.2026.1798154/full},
	doi = {10.3389/fpubh.2026.1798154},
	abstract = {Communicating scientific ideas to policy actors is a longstanding challenge, especially in epidemiological modeling where evidence is inherently uncertain. Central to this communication is visualization—the graphic representation of complex epidemiological modeling concepts through figures, plots, and charts. Effective model visualizations should be clear, simple, and easy to understand. This article brings theory from vision science to equip modelers in developing their understanding of and ability to assess and improve visualizations in their own settings. Designers can leverage fundamentals in vision science to aid their communication of modeling concepts to policymakers. We classify the different ways a modeling visual might fail and provide the necessary theory and examples for overcoming these problems in an epidemiological setting.},
	language = {English},
	urldate = {2026-08-29},
	journal = {Frontiers in Public Health},
	publisher = {Frontiers},
	author = {Hadley, Liza and Holliman, Nick and Xu, Kai and Bogucka, Edyta and Shu, Xinhuan and Archambault, Daniel and Landgren, Kath and DeGennaro, Ellen M. and Kissler, Stephen M.},
	month = may,
