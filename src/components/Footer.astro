---
import { profile, socials, nav } from '../config';
import { route } from '../lib/routes';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--border)] bg-[var(--bg-subtle)]">
  <div class="container-wide py-12">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <span
            class="grid size-8 shrink-0 place-items-center rounded-md bg-[var(--color-accent-700)] font-serif text-sm font-bold text-white dark:bg-[var(--color-accent-500)]"
            >KX</span
          >
          <span class="font-serif font-semibold tracking-tight">{profile.name}</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-[var(--fg-muted)]">
          {profile.tagline}
        </p>
        <a
          href={`mailto:${profile.email}`}
          class="mt-3 inline-flex items-center gap-1.5 text-sm text-[var(--link)] no-underline hover:underline"
        >
          <Icon name="mail" class="size-4" />
          {profile.email}
        </a>
      </div>

      <div>
        <h2 class="font-sans text-xs font-semibold tracking-wider text-[var(--fg-subtle)] uppercase">
          Pages
        </h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-8 gap-y-1.5">
          {
            nav.map((item) => (
              <li>
                <a href={route(item.href)} class="text-sm text-[var(--fg-muted)] no-underline hover:text-[var(--link)] hover:underline">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-sans text-xs font-semibold tracking-wider text-[var(--fg-subtle)] uppercase">
          Elsewhere
        </h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  rel="me noopener"
                  target="_blank"
                  class="inline-flex items-center gap-1.5 text-sm text-[var(--fg-muted)] no-underline hover:text-[var(--link)] hover:underline"
                >
                  <Icon name={social.icon} class="size-4 shrink-0" />
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-[var(--border)] pt-6 text-xs text-[var(--fg-subtle)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {profile.name}. Content licensed CC BY 4.0 unless noted.</p>
      <p>
        Built with <a href="https://astro.build" rel="noopener" class="text-[var(--fg-muted)]">Astro</a>
      </p>
    </div>
  </div>
</footer>