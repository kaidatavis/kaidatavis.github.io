---
import type { Publication } from '../lib/publications';
import { citationText, doiUrl, pubAnchor } from '../lib/publications';
import Icon from './Icon.astro';

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;

const href = pub.doi ? doiUrl(pub.doi) : pub.url;

/** "Kai Xu" rendered bold wherever it appears in the author list. */
const authors = pub.authors.map((a) => ({
  name: a.given ? `${a.given} ${a.family}` : a.family,
  isSelf: /^kai\s+xu$/i.test(`${a.given} ${a.family}`.trim()),
}));

const locator = [
  pub.volume,
  pub.number ? `(${pub.number})` : '',
  pub.pages ? `:${pub.pages}` : '',
].join('');

const citation = citationText(pub);
const isSelfFirst = authors[0]?.isSelf;
const others = authors.filter((a) => !a.isSelf);
---

<article
  id={pubAnchor(pub)}
  class="pub-item scroll-mt-32 border-b border-[var(--border)] py-6 last:border-b-0"
  data-search={pub.search}
  data-category={pub.category}
  data-year={pub.year}
>
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <h3 class="font-serif text-[1.05rem] leading-snug font-semibold">
      {
        href ? (
          <a href={href} rel="noopener" target="_blank" class="no-underline hover:underline">
            {pub.title}
          </a>
        ) : (
          <span>{pub.title}</span>
        )
      }
    </h3>
    <span
      class="shrink-0 rounded-full border border-[var(--border)] bg-[var(--bg-subtle)] px-2 py-px font-sans text-[0.65rem] font-medium tracking-wide text-[var(--fg-subtle)] uppercase"
      >{pub.category}</span
    >
  </div>

  <p class="mt-1.5 text-[0.9rem] leading-relaxed text-[var(--fg-muted)]">
    {
      isSelfFirst ? (
        <>
          <strong class="font-semibold text-[var(--fg)]">Kai Xu</strong>
          {others.length > 0 && <>, {others.map((a) => a.name).join(', ')}</>}
        </>
      ) : authors.length === 0 ? (
        <em class="text-[var(--fg-subtle)]">Authors unavailable</em>
      ) : (
        <>
          {others.map((a) => a.name).join(', ')},{' '}
          {authors.some((a) => a.isSelf) ? (
            <strong class="font-semibold text-[var(--fg)]">Kai Xu</strong>
          ) : (
            <span>{authors.map((a) => a.name).join(', ')}</span>
          )}
        </>
      )
    }
  </p>

  <p class="mt-1 text-[0.9rem]">
    {
      pub.venue && (
        <span class="italic">
          {pub.venue}
          {locator && <span class="not-italic">{locator}</span>}
        </span>
      )
    }
    <span class="text-[var(--fg-subtle)]"> · {pub.year}</span>
  </p>

  {
    pub.abstract && (
      <details class="group mt-2">
        <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-[0.8rem] text-[var(--fg-subtle)] hover:text-[var(--link)]">
          <Icon
            name="arrowRight"
            class="size-3 transition-transform group-open:rotate-90"
          />
          Abstract
        </summary>
        <p class="mt-2 border-l-2 border-[var(--border-strong)] pl-3 text-[0.9rem] leading-relaxed text-[var(--fg-muted)]">
          {pub.abstract}
          {pub.abstractTruncated && (
            <span class="text-[var(--fg-subtle)]"> …</span>
          )}
        </p>
      </details>
    )
  }

  <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.78rem]">
    {
      pub.doi && (
        <a
          href={doiUrl(pub.doi)}
          rel="noopener"
          target="_blank"
          class="inline-flex items-center gap-1 text-[var(--fg-subtle)] no-underline hover:text-[var(--link)] hover:underline"
        >
          <Icon name="doi" class="size-3.5" />
          <span class="font-mono">{pub.doi}</span>
        </a>
      )
    }
    {
      !pub.doi && pub.url && (
        <a
          href={pub.url}
          rel="noopener"
          target="_blank"
          class="inline-flex items-center gap-1 text-[var(--fg-subtle)] no-underline hover:text-[var(--link)] hover:underline"
        >
          <Icon name="external" class="size-3.5" />
          Link
        </a>
      )
    }
    <button
      type="button"
      class="copy-citation inline-flex cursor-pointer items-center gap-1 text-[var(--fg-subtle)] hover:text-[var(--link)]"
      data-citation={citation}
    >
      <Icon name="copy" class="size-3.5" />
      <span class="copy-label">Copy citation</span>
    </button>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-citation').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.dataset.citation ?? '';
      const label = button.querySelector('.copy-label');
      try {
        await navigator.clipboard.writeText(text);
        if (label) {
          label.textContent = 'Copied';
          setTimeout(() => (label.textContent = 'Copy citation'), 1600);
        }
      } catch {
        if (label) label.textContent = 'Press Ctrl+C';
      }
    });
  });
</script>