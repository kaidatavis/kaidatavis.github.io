---
import BaseLayout from "../layouts/BaseLayout.astro";
import { asset, route } from "../lib/routes";
import Icon from "../components/Icon.astro";
import { profile, socials } from "../config";
import { doiUrl, getPublications } from "../lib/publications";
import { grants } from "../data/funding";
import { serviceGroups } from "../data/services";

interface NewsItem {
  kind: "Funding" | "Publication" | "Service";
  title: string;
  detail: string;
  href: string;
}

/** Funding, papers and service roles from 2026. */
const news: NewsItem[] = [
  ...grants
    .filter((grant) => grant.year === 2026)
    .map((grant) => ({
      kind: "Funding" as const,
      title: grant.title,
      detail: [grant.role, grant.amount].filter(Boolean).join(" · "),
      href: route("/funding"),
    })),
  ...getPublications()
    .filter(
      (pub) =>
        pub.year === 2026 &&
        (pub.category === "Journal" || pub.category === "Conference"),
    )
    .map((pub) => ({
      kind: "Publication" as const,
      title: pub.title,
      detail: `${pub.venue} · ${pub.year}`,
      href: pub.doi ? doiUrl(pub.doi) : (pub.url ?? route("/papers")),
    })),
  ...serviceGroups
    .flatMap((group) => group.items)
    .filter((item) => item.years?.includes("2026"))
    .map((item) => ({
      kind: "Service" as const,
      title:
        item.role && item.venue
          ? `${item.role}, ${item.venue}`
          : (item.venue ?? item.role ?? ""),
      detail: item.years ?? "",
      href: route("/services"),
    })),
].slice(0, 8);

const highlights = [
  {
    href: "/projects",
    title: "Student projects",
    body: "Project ideas with scholarship details for PhD, internship and MSc students.",
    cta: "See open projects",
  },
  {
    href: "/papers",
    title: "Selected publications",
    body: "Research on visual analytics, provenance, sensemaking and human-AI collaboration.",
    cta: "Browse all papers",
  },
  {
    href: "/funding",
    title: "Research funding",
    body: "Grants and projects across EPSRC, EU, defence and industry collaborators.",
    cta: "View funding record",
  },
];
---

<BaseLayout
  title="Human-AI Collaboration"
  description={`${profile.name} is ${profile.title} at ${profile.institution}, working on human-AI collaboration, data visualisation and visual analytics.`}
  suffixTitle={false}
>
  <!-- Hero -->
  <section class="container-page pt-16 pb-4 sm:pt-24">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-10">
      <img
        src={asset(profile.photo.src)}
        alt={profile.photo.alt}
        width="132"
        height="132"
        loading="eager"
        decoding="async"
        class="size-28 shrink-0 rounded-full object-cover ring-1 ring-[var(--border-strong)] ring-offset-2 ring-offset-[var(--bg)] sm:size-32"
      />

      <div class="min-w-0">
        <h1
          class="font-serif text-3xl font-bold tracking-tight sm:text-[2.5rem] sm:leading-tight"
        >
          {profile.name}
          <span
            class="ml-2 text-xl font-normal text-[var(--fg-subtle)] sm:text-2xl"
            >{profile.nameLocal}</span
          >
        </h1>

        <p class="mt-3 text-lg leading-relaxed text-[var(--fg-muted)]">
          <a href={profile.profileUrl} rel="noopener" target="_blank"
            >{profile.title}</a
          > at{" "}
          <a href={profile.schoolUrl} rel="noopener" target="_blank"
            >{profile.school}</a
          >,{" "}
          <a href={profile.institutionUrl} rel="noopener" target="_blank"
            >{profile.institution}</a
          >, UK.
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-2">
          <a
            href={`mailto:${profile.email}`}
            class="inline-flex items-center gap-1.5 rounded-md bg-[var(--color-accent-700)] px-3.5 py-2 text-sm font-medium text-white no-underline transition-colors hover:bg-[var(--color-accent-800)] dark:bg-[var(--color-accent-500)] dark:text-[var(--color-accent-950)] dark:hover:bg-[var(--color-accent-400)]"
          >
            <Icon name="mail" class="size-4" />
            Get in touch
          </a>

          {
            socials.slice(0, 4).map((social) => (
              <a
                href={social.href}
                rel="me noopener"
                target="_blank"
                title={social.label}
                aria-label={social.label}
                class="inline-flex items-center gap-1.5 rounded-md border border-[var(--border-strong)] px-3 py-2 text-sm text-[var(--fg-muted)] no-underline transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--fg)]"
              >
                <Icon name={social.icon} class="size-4" />
                <span class="hidden sm:inline">{social.label}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="container-page py-12">
    <div class="prose-body max-w-none space-y-4">
      <p>
        I am an <strong>Associate Professor</strong> in the{" "}
        <a href={profile.schoolUrl} rel="noopener" target="_blank"
          >School of Computer Science</a
        > at the{" "}
        <a href={profile.institutionUrl} rel="noopener" target="_blank"
          >University of Nottingham</a
        >, UK. I am{" "}
        <strong>co-director</strong> of{" "}
        <a href={profile.vistag.url} rel="noopener" target="_blank"
          >{profile.vistag.name}</a
        >, an organiser of the{" "}
        <a
          href="https://www.turing.ac.uk/research/interest-groups/visualization"
          rel="noopener"
          target="_blank">Visualisation Interest Group</a
        >{" "}
        at the Alan Turing Institute, and chair of the{" "}
        <a href="http://eguk.org.uk/" rel="noopener" target="_blank"
          >UK branch of Eurographics</a
        >.
      </p>

      <p>
        My research sits at the intersection of <strong
          >AI/Machine Learning</strong
        > and{" "}
        <strong>Data Visualisation</strong>. The latter is about presenting data
        visually so that people can find patterns using human cognition and
        domain knowledge. Currently I focus on{" "}
        <strong>Human-AI Collaboration</strong>, particularly <a
          href="https://www.linkedin.com/pulse/human-centred-agentic-science-kai-xu-inkce/"
          rel="noopener"
          target="_blank">AI Co-Scientist</a
        >, to transform scientific discovery.
      </p>

      <p>
        I have led many research projects with a total value of over <strong
          >£12 million</strong
        >, funded by UK and EU research councils (EPSRC, EU Framework
        Programme), government bodies (Ministry of Defence, Dstl, US Department
        of Homeland Security) and industry (Microsoft, British Telecom).
      </p>
    </div>
  </section>

  <!-- News -->
  {
    news.length > 0 && (
      <section class="container-page py-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-serif text-xl font-semibold tracking-tight">News</h2>
          <span class="shrink-0 font-sans text-sm text-[var(--fg-subtle)]">
            2026
          </span>
        </div>

        <ul class="mt-4 divide-y divide-[var(--border)] border-t border-[var(--border)]">
          {news.map((item) => (
            <li class="py-4">
              <a
                href={item.href}
                rel={item.href.startsWith("http") ? "noopener" : undefined}
                target={item.href.startsWith("http") ? "_blank" : undefined}
                class="block no-underline"
              >
                <p class="font-medium text-[var(--fg)] group-hover:text-[var(--link)]">
                  <span class="mr-2 inline-block rounded bg-[var(--bg-subtle)] px-1.5 py-0.5 align-middle font-sans text-[0.7rem] font-medium tracking-wide text-[var(--fg-muted)] uppercase">
                    {item.kind}
                  </span>
                  {item.title}
                </p>
                {item.detail && (
                  <p class="mt-0.5 text-sm text-[var(--fg-muted)]">{item.detail}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Contact -->
  <section class="border-t border-[var(--border)] bg-[var(--bg-subtle)]">
    <div class="container-page py-14">
      <div class="max-w-2xl">
        <h2 class="font-serif text-xl font-semibold tracking-tight">
          Get in touch
        </h2>
        <p class="prose-body mt-2 text-[var(--fg-muted)]">
          If you are a <strong>company or academic</strong> interested in visualisation
          or human-centred AI, I would be glad to hear from you.
        </p>
        <p class="prose-body mt-2 text-[var(--fg-muted)]">
          If you are a <strong>student</strong> looking for an internship or PhD,
          the{" "}
          <a href={route("/projects")}>projects page</a> lists current opportunities
          and scholarship details.
        </p>
        <a
          href={`mailto:${profile.email}`}
          class="mt-5 inline-flex items-center gap-2 font-mono text-sm text-[var(--link)] no-underline hover:underline"
        >
          <Icon name="mail" class="size-4" />
          {profile.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
