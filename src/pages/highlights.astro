---
import BaseLayout from "../layouts/BaseLayout.astro";
import { grants } from "../data/funding";
import { serviceGroups } from "../data/services";
import { awards } from "../data/awards";
import { route } from "../lib/routes";

/** Each section shows at most this many entries, newest first. */
const LIMIT = 4;

/** First year in a period or `years` string, e.g. "2022–present" -> 2022. */
function startYear(years: string | undefined): number {
  const match = years?.match(/\d{4}/);
  return match ? Number(match[0]) : 0;
}

/** Newest first, ties keeping the order the data files list them in. */
const allGrants = grants
  .filter((grant) => grant.highlight)
  .sort((a, b) => startYear(b.period) - startYear(a.period));
const allServices = serviceGroups
  .flatMap((group) => group.items.filter((item) => item.highlight))
  .sort((a, b) => startYear(b.years) - startYear(a.years));
const allAwards = [...awards].sort((a, b) => b.year - a.year);

const highlightedGrants = allGrants.slice(0, LIMIT);
const highlightedServices = allServices.slice(0, LIMIT);
const highlightedAwards = allAwards.slice(0, LIMIT);

const description = `Selected grants, professional service and awards: ${highlightedGrants.length} research projects, ${highlightedServices.length} professional roles and ${highlightedAwards.length} awards.`;
---

<BaseLayout title="Highlights" description={description}>
  <div class="container-page py-12 sm:py-16">
    <header class="max-w-2xl">
      <h1 class="font-serif text-3xl font-bold tracking-tight sm:text-4xl">
        Highlights
      </h1>
    </header>

    <section class="mt-14">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="font-serif text-xl font-semibold tracking-tight">
          Research funding
        </h2>
        <a
          href={route("/funding")}
          class="shrink-0 text-sm text-[var(--link)] no-underline hover:underline"
        >
          All {grants.length} grants →
        </a>
      </div>

      <ol class="mt-6 space-y-5">
        {
          highlightedGrants.map((grant) => (
            <li class="border-l-2 border-[var(--color-accent-400)] pl-5">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-serif text-base leading-snug font-semibold tracking-tight">
                  {grant.title}
                </h3>
                <span class="font-sans text-xs tracking-wide text-[var(--fg-subtle)]">
                  {grant.period}
                </span>
              </div>

              <dl class="mt-1.5 flex flex-wrap gap-x-6 gap-y-1 font-sans text-[0.8rem]">
                {grant.amount && (
                  <div class="flex gap-1.5">
                    <dt class="shrink-0 text-[var(--fg-subtle)]">Funding</dt>
                    <dd>{grant.amount}</dd>
                  </div>
                )}
                {grant.role && (
                  <div class="flex gap-1.5">
                    <dt class="shrink-0 text-[var(--fg-subtle)]">Role</dt>
                    <dd>{grant.role}</dd>
                  </div>
                )}
              </dl>

              {grant.funder && (
                <p class="mt-1 font-sans text-[0.8rem] text-[var(--fg-muted)]">
                  {grant.funder}
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-14">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="font-serif text-xl font-semibold tracking-tight">
          Professional service
        </h2>
        <a
          href={route("/services")}
          class="shrink-0 text-sm text-[var(--link)] no-underline hover:underline"
        >
          All roles →
        </a>
      </div>

      <ul class="mt-6 space-y-4">
        {
          highlightedServices.map((item) => (
            <li class="border-l-2 border-[var(--color-accent-400)] pl-5">
              <p class="font-serif text-base leading-snug font-semibold tracking-tight">
                {item.role && item.venue ? (
                  <>
                    {item.role},{" "}
                    {item.url ? (
                      <a
                        href={item.url}
                        rel="noopener"
                        target="_blank"
                        class="no-underline hover:underline"
                      >
                        {item.venue}
                      </a>
                    ) : (
                      item.venue
                    )}
                  </>
                ) : (
                  (item.venue ?? item.role)
                )}
              </p>
              {item.years && (
                <p class="mt-0.5 font-sans text-xs tracking-wide text-[var(--fg-subtle)]">
                  {item.years}
                </p>
              )}
              {item.note && (
                <p class="prose-body mt-1 text-[0.9rem] text-[var(--fg-muted)]">
                  {item.note}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="font-serif text-xl font-semibold tracking-tight">Awards</h2>
        <a
          href={route("/bio")}
          class="shrink-0 text-sm text-[var(--link)] no-underline hover:underline"
        >
          More on bio →
        </a>
      </div>

      <ul class="mt-6 space-y-4">
        {
          highlightedAwards.map((award) => (
            <li class="border-l-2 border-[var(--color-accent-400)] pl-5">
              <p class="font-serif text-base leading-snug font-semibold tracking-tight">
                {award.title}
              </p>
              <p class="mt-0.5 font-sans text-xs tracking-wide text-[var(--fg-subtle)]">
                {award.year} · {award.venue}
              </p>
              {award.note && (
                <p class="prose-body mt-1 text-[0.9rem] text-[var(--fg-muted)]">
                  {award.note}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
