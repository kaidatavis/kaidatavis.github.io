---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const all = await getCollection("projects");

function sortByOrder<T extends (typeof all)[number]>(list: T[]) {
  return [...list].sort((a, b) => {
    const ao = a.data.order ?? Number.MAX_SAFE_INTEGER;
    const bo = b.data.order ?? Number.MAX_SAFE_INTEGER;
    if (ao !== bo) return ao - bo;
    return (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0);
  });
}

const closed = sortByOrder(all.filter((r) => r.data.status !== "open"));

const scholarships = [
  {
    year: "2026",
    items: [
      {
        text: "PhD scholarships for September 2026 start, open to UK and international students. Deadline 7 January 2026. This is very competitive — successful applicants usually have several strong publications already.",
        href: "https://jobs.nottingham.ac.uk/Vacancy.aspx?ref=SCI3046",
        label: "University listing",
      },
    ],
  },
  {
    year: "2025",
    items: [
      {
        text: "LLM-based analysis of ancient Roman tablets, in collaboration with the British Museum. Open to international students; deadline 2 June 2025.",
        href: "https://jobs.nottingham.ac.uk/Vacancy.aspx?ref=ARTS124",
        label: "University listing",
      },
      {
        text: "Nottingham AI doctoral training centre scholarships for September 2025 start. UK students only; deadline 6 May 2025. Two topics I supervised: human-AI collaboration for medical data mapping using LLM recommendations, decision explanations and feedback, and LLM-aided ontology-based knowledge modelling for built-environment contract management.",
        href: "https://www.nottingham.ac.uk/computerscience/studywithus/postgraduateresearch/nottinghamdtcinai.aspx",
        label: "AIDC page",
      },
    ],
  },
];
---

<BaseLayout
  title="Students"
  description="Project ideas for PhD, internship and MSc students, with scholarship and application details."
>
  <div class="container-page py-12 sm:py-16">
    <header class="max-w-2xl">
      <h1 class="font-serif text-3xl font-bold tracking-tight sm:text-4xl">
        Students
      </h1>
      <p class="prose-body mt-3 text-[var(--fg-muted)]">
        Project ideas for PhD, internship and MSc students, with scholarship and
        application details.
      </p>

      <h2 class="text-2xl mt-8">Internship</h2>
      <p class="mt-2">
        I welcome internship students. The internships are usually online/remote
        and without pay. This can be during the summer holiday or during the
        semester while you are studying. Please contact me if you are interested
        in one of the project ideas listed below. Currently I do not have
        capacity for other project ideas, unless it is about <strong
          >agentic science</strong
        > 😁 (please see the details below).
      </p>

      <h2 class="text-2xl mt-8">PhD</h2>
      <p class="mt-3">
        I usually would have an online meeting first so we can have a quick
        chat. After that I may request you to work with me on a research project
        for a few months if time allows (similar to the Internship mentioned
        before). This would allow us to know each other a bit better, and
        especially important if we never meet before or you need scholarship.
      </p>

      <section class="mt-6">
        <h2 class="font-serif text-xl font-semibold tracking-tight">
          PhD - Self-Funded
        </h2>
        <p class="mt-2">
          You will have a much better chance of being accepted if you can fund
          your study. There are <strong>Teaching Assistant opportunities</strong
          >, but these <strong>
            will not be enough for the tuition and living expenses</strong
          >.
        </p>

        <p class="mt-4">
          If this fits you, please see below a list of projects I am actively
          working on and looking for students. You can also propose your own
          project ideas and I will be happy to discuss them.
        </p>

        <section class="mt-6">
          <h2 class="font-serif text-xl">PhD - Scholarships Required</h2>
          <h3 class="text-lg mt-2">UK students</h3>
          <p class="mt-2">
            There are often PhD scholarship opportunities only for UK students
            and they are not as competitive. Please contact me by email for
            details.
          </p>
          <h3 class="text-lg mt-4">Non-UK Students</h3>
          <p class="mt-2">
            Scholarships for non-UK students have become very competitive
            recently. You will need <strong
              >two or three publications in top conferences or journals to have
              a realistic chance.</strong
            > This is a very high bar, but recent students who received scholarships
            met or exceeded this.
          </p>
        </section>
        <section class="mt-6">
          <h2 class="font-serif text-xl font-semibold tracking-tight">
            Previous PhD scholarships
          </h2>
          <p class="mt-2">
            Currently there is no open PhD scholarships. Below are some examples
            of scholarships that have been available in the past.
          </p>

          <div class="mt-5 space-y-7">
            {
              scholarships.map((group) => (
                <div>
                  <h3 class="font-sans text-xs font-semibold tracking-widest text-[var(--fg-subtle)] uppercase">
                    {group.year}
                  </h3>
                  <ul class="mt-3 space-y-4">
                    {group.items.map((item) => (
                      <li class="border-l-2 border-[var(--color-accent-400)] pl-4">
                        <p class="prose-body text-[0.95rem] text-[var(--fg-muted)]">
                          {item.text}
                          {item.href && (
                            <>
                              {" "}
                              <a
                                href={item.href}
                                rel="noopener"
                                target="_blank"
                              >
                                {item.label} ↗
                              </a>
                            </>
                          )}
                        </p>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </section>

        <section class="mt-14">
          <h2 class="font-serif text-2xl font-semibold tracking-tight">
            Project Ideas
          </h2>
          <div class="prose-body mt-3 space-y-3 text-[var(--fg-muted)]">
            <p>
              <strong>Human-Centred Agentic Science</strong> explores how AI agents
              can support researchers across the stages of scientific discovery, from
              literature research and hypothesis generation to implementation, evaluation
              and writing. The aim is to let AI take on time-consuming work while
              researchers guide the process, apply their expertise and make the important
              decisions — not to automate science end-to-end. <a
                href="https://www.linkedin.com/pulse/human-centred-agentic-science-kai-xu-inkce/"
                >Read more about Human-Centred Agentic Science ↗</a
              >
            </p>
            <p>
              Below are more specific project ideas, all under the <strong
                >Human-Centred Agentic Science</strong
              >:
            </p>
          </div>

          <div class="mt-6 space-y-6">
            <article>
              <h3 class="font-serif text-xl font-semibold tracking-tight">
                Idea 1: Human-Centred Agentic Science for Literature Research
              </h3>
              <p class="prose-body mt-2 text-[var(--fg-muted)]">
                Develop tools that help researchers explore a field, understand
                relationships across papers and identify research gaps. Agents
                can iteratively suggest topics and relevant work, while
                researchers steer the exploration with feedback and draw their
                own conclusions. This could build on focused literature
                collections and systems such as vitaLITy 2 and AwesomeLit. <a
                  href="https://www.linkedin.com/pulse/human-centred-agentic-science-2-literature-research-kai-xu-dpr2e/"
                  rel="noopener"
                  target="_blank"
                >
                  Read more about this project idea ↗</a
                >
              </p>
            </article>

            <article>
              <h3 class="font-serif text-xl font-semibold tracking-tight">
                Idea 2: Human-Centred Agentic Science for Quantitative Research
              </h3>
              <p class="prose-body mt-2 text-[var(--fg-muted)]">
                There are many different types of quantitative researches. Here
                we use human-guided machine learning for automated trading as an
                example: combining market data with news sentiment, exploring
                reinforcement-learning and time-series anomaly-detection
                approaches, and building interactive tools to compare and tune
                models. The focus is on helping researchers inspect performance
                and guide experimentation, rather than assuming a model will
                reliably make profitable trades. <a
                  href="https://kaixu.wordpress.com/2024/09/15/llm-for-automated-trading/"
                  rel="noopener"
                  target="_blank">Read more about this project idea ↗</a
                >
              </p>
            </article>

            <article>
              <h3 class="font-serif text-xl font-semibold tracking-tight">
                Idea 3: Human-Centred Agentic Science for Qualitative Research
              </h3>
              <p class="prose-body mt-2 text-[var(--fg-muted)]">
                Explore how LLMs can assist with repetitive parts of qualitative
                analysis, such as first-pass coding and checking consistency
                across themes or coders. Researchers review the evidence and
                recommendations, retaining control over interpretation and
                decisions. One example is Co-Refine, which flags possible coding
                inconsistencies during analysis. <a
                  href="https://www.linkedin.com/pulse/human-centred-agentic-science-3-qualitative-analysis-kai-xu-finhe/"
                  rel="noopener"
                  target="_blank">Read more about this project idea ↗</a
                >
              </p>
            </article>
          </div>
        </section>

        {
          closed.length > 0 && (
            <section class="mt-14">
              <h2 class="font-serif text-xl font-semibold tracking-tight">
                Previous projects
              </h2>
              <p class="mt-1 text-sm text-[var(--fg-subtle)]">
                No longer recruiting students, but useful context on where this
                work has gone.
              </p>
              <div class="mt-5 space-y-5">
                {closed.map((entry) => (
                  <ProjectCard project={entry} />
                ))}
              </div>
            </section>
          )
        }
      </section>
    </header>
  </div>
</BaseLayout>
